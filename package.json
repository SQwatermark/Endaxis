{
  "name": "endaxis-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "convert:images": "node scripts/convert-png-to-webp.js",
    "type-check": "vue-tsc --noEmit --project tsconfig.app.json",
    "type-check:next": "vue-tsc --noEmit --project tsconfig.next.json",
    "type-check:game-data": "tsc --project tools/game-data-compiler/tsconfig.json",
    "test": "vitest",
    "test:next": "vitest run src/next",
    "test:game-data": "vitest run tools/game-data-compiler",
    "audit:game-data:operators": "node --experimental-strip-types tools/game-data-compiler/scripts/auditOperatorSourceClosures.ts",
    "audit:game-data:weapons": "node --experimental-strip-types tools/game-data-compiler/scripts/auditWeaponStaticDefinitions.ts",
    "plan:game-data:operator-unity-templates": "node --experimental-strip-types tools/game-data-compiler/scripts/planOperatorUnityTemplates.ts",
    "download:game-data:operator-closure": "node --experimental-strip-types tools/game-data-compiler/scripts/downloadOperatorSourceClosure.ts",
    "download:game-data:sources": "node --experimental-strip-types tools/game-data-compiler/scripts/downloadAkedbSources.ts",
    "generate:game-data:gameplay-tags": "node --experimental-strip-types tools/game-data-compiler/scripts/generateGameplayTagCatalog.ts",
    "bench:next": "vitest bench --run src/next/benchmarks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "@zumer/snapdom": "^2.0.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.6.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.2.2"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,jsonc,css,scss,html,md}": "prettier --write"
  }
}
